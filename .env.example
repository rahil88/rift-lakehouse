# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never commit it. Keep one KEY=value per line, no quotes, no spaces around "=".

# --- Riot API (https://developer.riotgames.com) ---
# Development keys deactivate every 24h: regenerate in the portal and update this line.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Platform routing value (league-v4, status-v4)
RIOT_PLATFORM=na1
# Regional routing value (match-v5, account-v1)
RIOT_REGION=americas

# --- Redpanda (Kafka API), as seen from your laptop ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# --- Databricks Free Edition (used from Phase 3) ---
# Host looks like https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# Settings -> Developer -> Access tokens. Paste it here, never in chat or code.
DATABRICKS_TOKEN=
# SQL warehouse -> Connection details -> HTTP path, e.g. /sql/1.0/warehouses/abc123
DATABRICKS_HTTP_PATH=

# --- Airflow secrets (read by docker compose only, NOT passed to containers wholesale) ---
# Encrypts Connections/Variables in the metadata DB.
# Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# Signs tokens between Airflow components.
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
